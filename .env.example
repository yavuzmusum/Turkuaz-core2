# Bu dosyayi .env olarak kopyalayip doldurun (turkuaz-core/ klasorunde).
# .env dosyasi asla git'e commit edilmemeli.

JWT_SECRET_KEY=degistir-bunu-uzun-rastgele-bir-deger-ile

# Bos birakilirsa sohbet MockProvider ile calismaya devam eder.
# https://aistudio.google.com/apikey adresinden alinabilir.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Gemini kota/rate-limit hatasi verirse otomatik olarak buna dusulur.
# Bos birakilirsa Ollama hic denenmez. Once "ollama serve" ve
# "ollama pull llama3.1:8b" calistirmaniz gerekir.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
